{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Aggregation": {
    "Cache": {
      "FreshSeconds": 60,
      "FallbackHours": 24,
      "MaxEntries": 10000
    },
    "Resilience": {
      "AttemptTimeoutSeconds": 3,
      "TotalTimeoutSeconds": 5,
      "RetryCount": 2,
      "RetryBaseDelayMs": 200,
      "CircuitBreakerFailures": 3,
      "CircuitBreakDurationSeconds": 30
    },
    "Stats": {
      "FastBelowMs": 100,
      "SlowAboveMs": 200
    }
  },
  "Tmdb": {
    "ApiKey": "",
    "BaseAddress": "https://api.themoviedb.org/3/"
  },
  "GitHub": {
    "Token": "",
    "BaseAddress": "https://api.github.com/"
  },
  "CoinGecko": {
    "DemoApiKey": "",
    "BaseAddress": "https://api.coingecko.com/api/v3/"
  }
}
